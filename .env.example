# =============================================================================
# Copiar este archivo a .env y completar los valores.
# NUNCA versionar el archivo .env con credenciales reales.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (servicio `db` de docker-compose)
# -----------------------------------------------------------------------------
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=ecommerce

# La URL del backend se arma en docker-compose.yml apuntando a `db:5432`.
# Esta variable (localhost) queda para ejecutar comandos Prisma desde el host.
DATABASE_URL=postgresql://ecommerce:change_me_local_only@localhost:5432/ecommerce?schema=public

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Secretos JWT (generar con: openssl rand -hex 32  |  no usar placeholders)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Tiempos de vida en segundos
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
# URL interna para fetch desde Server Components (red de Docker)
API_INTERNAL_URL=http://backend:4000
# Client ID público de la app PayPal Sandbox (el MISMO que PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# -----------------------------------------------------------------------------
# PayPal Sandbox
# Obtener en https://developer.paypal.com/dashboard/applications/sandbox
# El Secret es privado: solo lo usa el backend.
# Guía completa: docs/paypal-sandbox.md
# -----------------------------------------------------------------------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
